.git
.github
.DS_Store

# Local environment and secrets are injected at runtime by compose/CI.
.env
**/.env
**/.env.*
!**/.env.example

# Frontend dependency/build artifacts are recreated inside Docker.
# (company-web도 이제 multi-stage로 컨테이너 안에서 빌드 — 호스트 dist 예외 불필요)
**/node_modules
**/dist
**/.vite
**/.turbo
**/.next
**/coverage

# Python caches and local test artifacts.
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage

# Runtime files should live in Docker volumes, not image layers.
backend/uploads
backend/logs

# 압축 안 된 RAG 덤프(수백 MB). 로더/익스포터는 .jsonl.gz 만 사용하므로
# 이미지에 구울 필요 없음. (.gz 와 vet_triage.json 등은 그대로 포함됨)
backend/data/**/*.jsonl
