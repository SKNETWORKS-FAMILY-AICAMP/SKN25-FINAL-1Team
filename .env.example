# MediPaw 환경변수 템플릿 — ⚠️ 로컬 개발용 예시값이다.
# 이 파일을 복사해서 .env 로 만들고 값을 채우세요: cp .env.example .env
#
# 운영(docker-compose.prod.yml)은 SECRET_KEY 를 기본값 없이 필수로 강제한다(:?).
# 즉, ~/medipaw/.env 에 진짜 SECRET_KEY 를 넣지 않으면 컨테이너가 아예 안 뜬다.
# → 아래 예시 SECRET_KEY 가 운영에 그대로 쓰일 일은 없다(반드시 교체).

# PostgreSQL (DB 는 내부 네트워크 전용이지만, 운영에선 강한 값으로 교체 권장)
POSTGRES_PASSWORD=medipaw_secret

# JWT — 운영에선 반드시 길고 랜덤한 문자열로 교체 (예: python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-in-production

# AWS S3 + CloudFront (미사용 시 빈값 유지)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=medipaw-images
CLOUDFRONT_URL=

# OpenAI (필수)
# 비용/품질 비교로 모델을 바꾸려면 backend/scripts/eval_models.py 로 후보를 sweep 한 뒤
# 여기 OPENAI_MODEL 값만 교체한다(코드 수정 불필요 — 전 에이전트가 이 값을 단일 소스로 읽음).
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.4-mini

# 서버 설정
DEBUG=false
