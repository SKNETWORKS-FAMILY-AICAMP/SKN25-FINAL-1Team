# syntax=docker/dockerfile:1.7
# company-web 정적 소개 사이트 — 미리 빌드한 dist를 nginx로 서빙한다.
#
# Mac(arm64)에서 amd64 이미지를 크로스빌드할 때 컨테이너 안에서 vite/esbuild를
# QEMU 에뮬레이션으로 돌리면 `fatal error: lfstack.push`로 죽는 알려진 버그가 있어,
# 빌드(npm run build)는 호스트에서 네이티브로 끝낸 뒤 그 결과물(dist)만 복사한다.
#
# 빌드 전 호스트에서:
#   cd frontend/company-web
#   VITE_GUARDIAN_URL=http://3.37.22.158:5173 VITE_VET_URL=http://3.37.22.158:5174 npm run build
FROM nginx:alpine

COPY frontend/company-web/dist /usr/share/nginx/html
COPY ai/docker/nginx-company.conf /etc/nginx/conf.d/default.conf

EXPOSE 5175

CMD ["nginx", "-g", "daemon off;"]
