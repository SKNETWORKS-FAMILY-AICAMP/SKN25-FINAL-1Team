# syntax=docker/dockerfile:1.7
# company-web(회사 소개 사이트) — 로컬 dev 전용.
# 운영 Dockerfile.company 는 호스트에서 미리 빌드한 dist 를 COPY 하지만(Mac→amd64
# 크로스빌드 esbuild 크래시 회피), dev 는 호스트(arm64) 네이티브라 컨테이너 안에서
# 그냥 빌드해도 안전하다. ./dev.sh 한 방으로 같이 뜨게 하려고 in-container 빌드를 쓴다.
FROM node:20-alpine AS builder

# guardian/vet 으로 가는 버튼 링크. 미지정 시 site.ts 기본값(localhost)이 쓰인다.
ARG VITE_GUARDIAN_URL=http://localhost:5173
ENV VITE_GUARDIAN_URL=$VITE_GUARDIAN_URL
ARG VITE_VET_URL=http://localhost:5174
ENV VITE_VET_URL=$VITE_VET_URL

WORKDIR /frontend/company-web

COPY frontend/company-web/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --prefer-offline

# shared assets 는 ../../../../shared 경로로 참조되므로 구조 보존
COPY frontend/shared/ ../shared/
COPY frontend/company-web/ ./

RUN npm run build

# ── production stage ──
FROM nginx:alpine

COPY --from=builder /frontend/company-web/dist /usr/share/nginx/html
COPY ai/docker/nginx-company.conf /etc/nginx/conf.d/default.conf

EXPOSE 5175

CMD ["nginx", "-g", "daemon off;"]
