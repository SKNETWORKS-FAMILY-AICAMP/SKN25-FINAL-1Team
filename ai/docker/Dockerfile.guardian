# syntax=docker/dockerfile:1.7
FROM node:20-alpine AS builder

ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ARG VITE_COMPANY_URL=http://localhost:5175
ENV VITE_COMPANY_URL=$VITE_COMPANY_URL

WORKDIR /frontend/guardian-web

# BuildKit 캐시 마운트로 npm 다운로드를 호스트에 보존 → 콜드 빌드 재다운로드 0.
COPY frontend/guardian-web/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --prefer-offline

# shared assets는 ../../../../shared 경로로 참조되므로 구조 보존
COPY frontend/shared/ ../shared/
COPY frontend/guardian-web/ ./
# (AI 훅은 frontend/guardian-web/src/hooks/use-agent-pipeline.ts 로 네이티브 이전됨.
#  과거 ai/frontend/*.ts shim COPY는 파일 삭제로 obsolete → 제거)

RUN npm run build

# ── production stage ──
FROM nginx:alpine

COPY --from=builder /frontend/guardian-web/dist /usr/share/nginx/html
COPY ai/docker/nginx-guardian.conf /etc/nginx/conf.d/default.conf

EXPOSE 5173

CMD ["nginx", "-g", "daemon off;"]
