# syntax=docker/dockerfile:1.7
FROM node:20-alpine AS builder

ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

WORKDIR /frontend/vet-web

# BuildKit 캐시 마운트로 npm 다운로드를 호스트에 보존 → 콜드 빌드 재다운로드 0.
COPY frontend/vet-web/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --prefer-offline

# shared assets는 ../../../../shared 경로로 참조되므로 구조 보존
COPY frontend/shared/ ../shared/
COPY frontend/vet-web/ ./
RUN npm run build

# ── production stage ──
FROM nginx:alpine

COPY --from=builder /frontend/vet-web/dist /usr/share/nginx/html
COPY ai/docker/nginx-vet.conf /etc/nginx/conf.d/default.conf

EXPOSE 5174

CMD ["nginx", "-g", "daemon off;"]
