# MediPaw 환경변수 (.env) 템플릿
# 사용법:  cp backend/.env.example backend/.env   (또는 ./dev.sh 가 자동 생성)
#
# ★ 도커로 로컬 개발만 할 거면 → 아래에서 OPENAI_API_KEY 한 줄만 채우면 됩니다.
#   (나머지는 비워도 backend가 뜹니다. S3/AI 기능을 실제로 쓸 때만 값이 필요해요.)
# ★ 비밀값(.env)은 절대 git에 올리지 마세요. (이미 .gitignore에 있음)

# ── 필수로 채우면 좋은 값 ─────────────────────────────────
# OpenAI (AI 트리아지/처방전 추천 쓰려면 필요. 팀 공용 키 받아서 넣기)
OPENAI_API_KEY=

# ── S3 쓸 사람만 (이미지 업로드/조회 기능). 안 쓰면 비워두기 ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=medipaw-images
CLOUDFRONT_URL=

# ── 아래는 도커가 자동으로 채워줌. 그냥 둬도 됨 ──────────────
# (docker-compose 가 DATABASE_URL/SECRET_KEY/ALLOWED_ORIGINS 등을 덮어씀)
POSTGRES_PASSWORD=medipaw_secret
SECRET_KEY=dev-secret-change-me-in-production
OPENAI_MODEL=gpt-5.4-mini
DEBUG=true
# 프론트 주소(CORS). 도커 기본은 5173(보호자)/5174(수의사)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
