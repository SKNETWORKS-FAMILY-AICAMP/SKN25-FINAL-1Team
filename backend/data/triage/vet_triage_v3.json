        { "label": "Suspected hypoglycemia", "urgency": "RED", "when": { "hypoglycemia": "suspected" } },
        { "label": "Anaphylaxis", "urgency": "RED", "when": { "anaphylaxis": "suspected" } },
        { "label": "Severe pain", "urgency": "ORANGE", "when": { "pain": "severe" } },
        { "label": "Marked lethargy", "urgency": "ORANGE", "when": { "lethargy": "marked" } },
        { "label": "Severe dehydration (>8%)", "urgency": "ORANGE", "when": { "dehydration": "severe" } },
        { "label": "Elevated temperature", "urgency": "YELLOW", "when": { "body_temp": "high" } },
        { "label": "Moderate pain", "urgency": "YELLOW", "when": { "pain": "moderate" } },
        { "label": "Mild dehydration", "urgency": "YELLOW", "when": { "dehydration": "mild" } },
        { "label": "Fever signs", "urgency": "YELLOW", "when": { "fever_signs": "yes" } },
        { "label": "Weight loss", "urgency": "YELLOW", "when": { "weight_loss": "yes" } },
        { "label": "Mild pain / local inflammation", "urgency": "GREEN", "when": { "pain": "mild" } },
        { "label": "Swollen lymph nodes", "urgency": "GREEN", "when": { "lymph_nodes": "yes" } },
        { "label": "Reduced appetite (general)", "urgency": "GREEN", "when": { "appetite_general": "reduced" } }
      ]
    }
  ]
}