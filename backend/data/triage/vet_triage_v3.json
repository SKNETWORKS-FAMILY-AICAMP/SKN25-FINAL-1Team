{
  "meta": {
    "version": "3.1-discriminator",
    "model": "Modified VTL (discriminator-based)",
    "source": "Ruys et al. 2012 (VTL) + CVJ Basic Triage in dogs & cats I–III (2024) Fig.1; 'extended'/추가 항목은 프로젝트 자체 확장(임상 합리성 기준, 수의사 검수 권장).",
    "scoring": "점수 가산 없음. 추출된 variables로 when의 모든 키가 일치하는 discriminator를 찾아 가장 높은 등급을 채택(RED>ORANGE>YELLOW>GREEN).",
    "design": "goal=질문LLM용(트리·잎 비노출) / variables=추출LLM용(사실값) / discriminators=엔진용(결정론 판정)."
  },

  "urgency_order": ["RED", "ORANGE", "YELLOW", "GREEN"],

  "urgency_labels": {
    "RED": { "vtl": "Immediate", "display": "응급", "twt_minutes": 0 },
    "ORANGE": { "vtl": "Very urgent", "display": "준응급", "twt_minutes": 15 },
    "YELLOW": { "vtl": "Urgent", "display": "준응급", "twt_minutes": 45 },
    "GREEN": { "vtl": "Standard", "display": "일반", "twt_minutes": 120 }
  },

  "red_flag_guidance": "생명을 위협하는 즉시-응급 신호(사용자에겐 '응급'이라 말하지 말 것): 심한 호흡곤란·청색증·개구호흡(특히 고양이), 지금 발작 중·연속 발작·의식 없음, 쇼크·대량 출혈, 복부가 갑자기 빵빵하게 부풀어오름(위염전), 체온 과고(>40.8℃)/과저(<37℃), 저혈당 의심, 독성물질 섭취, 난산·자궁축농증·산후 경련(자간), 요도폐색(소변 전혀 못 봄), 열사병·익수·감전·기도이물(질식). 이 신호가 보이면 해당 섹션의 RED discriminator로 즉시 분류된다.",

  "sections": [
    {
      "id": "RESPIRATORY",
      "label": "호흡 문제",
      "origin": "paper",
      "goal": "호흡곤란 정도와 특이 징후(협착음·피하기종·청색증), 기침·콧물·재채기·코피 양상을 파악한다.",
      "variables": {
        "breathing_severity": { "concept": "숨쉬기를 힘들어하는 정도(편함/약간/중간/심함)", "values": ["none", "mild", "moderate", "severe"] },
        "cyanosis": { "concept": "잇몸·혀가 파랗게 보임(산소부족)", "values": ["no", "yes"] },
        "breathing_rate": { "concept": "쉬는데도 숨이 빠르고 얕음(빈호흡)", "values": ["normal", "fast"] },
        "stridor": { "concept": "숨 쉴 때 끽-/그렁대는 상기도 협착음", "values": ["no", "yes"] },
        "subq_emphysema": { "concept": "피부 밑 공기로 만지면 바스락(피하기종)", "values": ["no", "yes"] },
        "cough": { "concept": "기침(없음/가끔/잦음/컹컹 거위소리)", "values": ["none", "occasional", "frequent", "honking"] },
        "nasal_discharge": { "concept": "콧물(없음/맑음/누렇고 끈적/피섞임)", "values": ["none", "clear", "purulent", "bloody"] },
        "sneezing": { "concept": "재채기·코막힘", "values": ["no", "yes"] }
      },
      "discriminators": [
        { "label": "Severe respiratory distress", "urgency": "RED", "when": { "breathing_severity": "severe" } },
        { "label": "Cyanosis", "urgency": "RED", "when": { "cyanosis": "yes" } },
        { "label": "Acute stridor", "urgency": "ORANGE", "when": { "stridor": "yes" } },
        { "label": "Subcutaneous emphysema", "urgency": "ORANGE", "when": { "subq_emphysema": "yes" } },
        { "label": "Moderate respiratory distress", "urgency": "ORANGE", "when": { "breathing_severity": "moderate" } },
        { "label": "Epistaxis (bloody nasal discharge)", "urgency": "ORANGE", "when": { "nasal_discharge": "bloody" } },
        { "label": "Tachypnea at rest", "urgency": "YELLOW", "when": { "breathing_rate": "fast" } },
        { "label": "Mild respiratory distress", "urgency": "YELLOW", "when": { "breathing_severity": "mild" } },
        { "label": "Purulent nasal discharge (URI)", "urgency": "YELLOW", "when": { "nasal_discharge": "purulent" } },
        { "label": "Honking cough (tracheal collapse)", "urgency": "YELLOW", "when": { "cough": "honking" } },
        { "label": "Frequent cough", "urgency": "YELLOW", "when": { "cough": "frequent" } },
        { "label": "Occasional cough", "urgency": "GREEN", "when": { "cough": "occasional" } },
        { "label": "Sneezing / clear nasal (mild URI)", "urgency": "GREEN", "when": { "sneezing": "yes" } },
        { "label": "Clear nasal discharge", "urgency": "GREEN", "when": { "nasal_discharge": "clear" } }
      ]
    },

    {
      "id": "NEUROLOGIC",
      "label": "신경 증상",
      "origin": "paper",
      "goal": "발작 양상·의식, 평형(머리기울임/돌기), 마비·진전·운동실조, 목 통증, 인지장애를 파악한다.",
      "variables": {
        "seizure_status": { "concept": "발작 상태(없음/최근 1회 끝남/연달아/지금 진행 중)", "values": ["none", "recent_single", "cluster", "active"] },
        "consciousness": { "concept": "의식 수준(정상/멍함/매우 처짐/무반응)", "values": ["normal", "dull", "stupor", "unresponsive"] },
        "vestibular": { "concept": "평형 이상(머리기울임/빙빙 돔·안구떨림)", "values": ["none", "head_tilt", "circling_nystagmus"] },
        "limb_function": { "concept": "다리 움직임(정상/약함/마비)", "values": ["normal", "paresis", "paralysis"] },
        "tremor": { "concept": "온몸 떨림·경련 같은 진전", "values": ["no", "yes"] },
        "ataxia": { "concept": "취한 듯 비틀비틀 걸음(운동실조)", "values": ["no", "yes"] },
        "neck_back_pain": { "concept": "목·등을 아파하며 안 움직이려 함", "values": ["no", "yes"] },
        "behavior": { "concept": "갑작스런 이상행동·끊임없는 비명", "values": ["normal", "acute_abnormal"] },
        "cognitive": { "concept": "노령견 멍하니 헤맴·방향감각 상실(인지장애)", "values": ["no", "yes"] }
      },
      "discriminators": [
        { "label": "Actively seizuring", "urgency": "RED", "when": { "seizure_status": "active" } },
        { "label": "Cluster seizures", "urgency": "RED", "when": { "seizure_status": "cluster" } },
        { "label": "Unresponsive", "urgency": "RED", "when": { "consciousness": "unresponsive" } },
        { "label": "Acute abnormal behavior", "urgency": "RED", "when": { "behavior": "acute_abnormal" } },
        { "label": "Altered consciousness (dull)", "urgency": "ORANGE", "when": { "consciousness": "dull" } },
        { "label": "Stupor", "urgency": "ORANGE", "when": { "consciousness": "stupor" } },
        { "label": "Acute paralysis", "urgency": "ORANGE", "when": { "limb_function": "paralysis" } },
        { "label": "Generalized tremor", "urgency": "ORANGE", "when": { "tremor": "yes" } },
        { "label": "Acute paresis / spinal deficit", "urgency": "YELLOW", "when": { "limb_function": "paresis" } },
        { "label": "Vestibular / head tilt", "urgency": "YELLOW", "when": { "vestibular": "head_tilt" } },
        { "label": "Circling / nystagmus", "urgency": "YELLOW", "when": { "vestibular": "circling_nystagmus" } },
        { "label": "Ataxia", "urgency": "YELLOW", "when": { "ataxia": "yes" } },
        { "label": "Neck / back pain (IVDD suspect)", "urgency": "YELLOW", "when": { "neck_back_pain": "yes" } },
        { "label": "Recent single seizure (recovered)", "urgency": "GREEN", "when": { "seizure_status": "recent_single" } },
        { "label": "Cognitive dysfunction (senior)", "urgency": "GREEN", "when": { "cognitive": "yes" } }
      ]
    },

    {
      "id": "CARDIOVASCULAR",
      "label": "순환/심장 문제",
      "origin": "paper",
      "goal": "쇼크·실신·출혈 정도, 심장 이상(심잡음·운동불내성·복수)을 파악한다. 잇몸색·기력·실신이 핵심.",
      "variables": {
        "perfusion": { "concept": "순환(정상/잇몸 창백/쇼크-차고 처지고 맥약함)", "values": ["normal", "pale_mm", "shock"] },
        "collapse": { "concept": "쓰러짐(없음/쓰러졌다 회복/지금 쓰러져 있음)", "values": ["none", "syncope_recovered", "collapsed_now"] },
        "hemorrhage": { "concept": "출혈(없음/소량/조절 안 되는 다량/분출성)", "values": ["none", "minor", "major", "profuse"] },
        "ate_signs": { "concept": "갑자기 뒷다리 마비+차갑고 극심한 통증(혈전색전)", "values": ["no", "yes"] },
        "exercise_intolerance": { "concept": "조금만 움직여도 헥헥대고 지침(운동불내성)", "values": ["no", "yes"] },
        "ascites": { "concept": "배에 물이 차 늘어짐(복수)", "values": ["no", "yes"] },
        "heart_sign": { "concept": "심잡음·불규칙 심박(주로 검진서 발견)", "values": ["none", "murmur"] }
      },
      "discriminators": [
        { "label": "Shock", "urgency": "RED", "when": { "perfusion": "shock" } },
        { "label": "Collapsed now", "urgency": "RED", "when": { "collapse": "collapsed_now" } },
        { "label": "Profuse hemorrhage", "urgency": "RED", "when": { "hemorrhage": "profuse" } },
        { "label": "Aortic thromboembolism signs", "urgency": "RED", "when": { "ate_signs": "yes" } },
        { "label": "Uncontrolled major bleeding", "urgency": "ORANGE", "when": { "hemorrhage": "major" } },
        { "label": "Pale mucous membranes (no shock)", "urgency": "ORANGE", "when": { "perfusion": "pale_mm" } },
        { "label": "Syncope recovered", "urgency": "ORANGE", "when": { "collapse": "syncope_recovered" } },
        { "label": "Ascites (fluid wave)", "urgency": "ORANGE", "when": { "ascites": "yes" } },
        { "label": "Uncontrollable minor bleeding", "urgency": "YELLOW", "when": { "hemorrhage": "minor" } },
        { "label": "Exercise intolerance", "urgency": "YELLOW", "when": { "exercise_intolerance": "yes" } },
        { "label": "Heart murmur (incidental)", "urgency": "GREEN", "when": { "heart_sign": "murmur" } }
      ]
    },

    {
      "id": "GASTROINTESTINAL",
      "label": "소화기 증상",
      "origin": "paper",
      "goal": "복부 팽만(특히 급성), 구토·설사·변비 양상, 이물 섭취, 식욕·복통·황달·흑변을 파악한다.",
      "variables": {
        "abdominal_distension": { "concept": "배가 부풂(없음/있음/갑자기 빵빵-위염전)", "values": ["none", "present", "rapid_onset"] },
        "vomiting": { "concept": "구토(없음/가끔/계속/피 섞임)", "values": ["none", "occasional", "persistent", "hematemesis"] },
        "diarrhea": { "concept": "설사(없음/약간/심함/혈변)", "values": ["none", "mild", "severe", "bloody"] },
        "foreign_body": { "concept": "이물 삼킴(아니오/가능성/24시간 넘고 식욕없음·구토)", "values": ["no", "possible", "likely_over_24h"] },
        "appetite": { "concept": "식욕(정상/줄음/하루 이상 전혀 안 먹음)", "values": ["normal", "reduced", "anorexic"] },
        "abdominal_pain": { "concept": "배를 만지면 아파하거나 기도자세(복통)", "values": ["none", "mild", "severe"] },
        "constipation": { "concept": "변을 못 보고 힘만 줌(변비)", "values": ["no", "yes"] },
        "regurgitation": { "concept": "먹자마자 소화 안 된 채 게워냄(역류)", "values": ["no", "yes"] },
        "jaundice": { "concept": "잇몸·눈·피부가 노래짐(황달)", "values": ["no", "yes"] },
        "melena": { "concept": "검은 타르색 변(흑변)", "values": ["no", "yes"] }
      },
      "discriminators": [
        { "label": "Rapid onset abdominal distension (GDV)", "urgency": "RED", "when": { "abdominal_distension": "rapid_onset" } },
        { "label": "Severe abdominal pain", "urgency": "ORANGE", "when": { "abdominal_pain": "severe" } },
        { "label": "Hematemesis", "urgency": "ORANGE", "when": { "vomiting": "hematemesis" } },
        { "label": "Possible foreign body >24h + signs", "urgency": "ORANGE", "when": { "foreign_body": "likely_over_24h" } },
        { "label": "Bloody diarrhea", "urgency": "ORANGE", "when": { "diarrhea": "bloody" } },
        { "label": "Jaundice", "urgency": "ORANGE", "when": { "jaundice": "yes" } },
        { "label": "Persistent vomiting", "urgency": "YELLOW", "when": { "vomiting": "persistent" } },
        { "label": "Melena", "urgency": "YELLOW", "when": { "melena": "yes" } },
        { "label": "Possible foreign body ingestion", "urgency": "YELLOW", "when": { "foreign_body": "possible" } },
        { "label": "Severe diarrhea", "urgency": "YELLOW", "when": { "diarrhea": "severe" } },
        { "label": "Abdominal distension (non-acute)", "urgency": "YELLOW", "when": { "abdominal_distension": "present" } },
        { "label": "Anorexia (>24h)", "urgency": "YELLOW", "when": { "appetite": "anorexic" } },
        { "label": "Constipation / obstipation", "urgency": "YELLOW", "when": { "constipation": "yes" } },
        { "label": "Regurgitation", "urgency": "YELLOW", "when": { "regurgitation": "yes" } },
        { "label": "Occasional vomiting", "urgency": "GREEN", "when": { "vomiting": "occasional" } },
        { "label": "Mild diarrhea", "urgency": "GREEN", "when": { "diarrhea": "mild" } },
        { "label": "Reduced appetite", "urgency": "GREEN", "when": { "appetite": "reduced" } }
      ]
    },

    {
      "id": "TOXIN",
      "label": "중독(독성물질 섭취)",
      "origin": "extended",
      "goal": "무엇을 얼마나 언제 먹었는지 파악한다. 알려진 독성물질이면 무증상이라도 시간이 생명이다.",
      "variables": {
        "substance": { "concept": "섭취 의심 물질", "values": ["none", "chocolate", "xylitol", "grapes_raisins", "onion_garlic", "rodenticide", "human_medication", "nsaid_acetaminophen", "antifreeze", "lily_cat", "toxic_plant", "marijuana_thc", "alcohol", "caffeine", "snail_bait", "essential_oil", "household_chemical", "battery", "unknown"] },
        "symptom_onset": { "concept": "증상 동반(없음/구토/신경증상/출혈)", "values": ["none", "vomiting", "neuro", "bleeding"] }
      },
      "discriminators": [
        { "label": "Xylitol ingestion", "urgency": "RED", "when": { "substance": "xylitol" } },
        { "label": "Rodenticide ingestion", "urgency": "RED", "when": { "substance": "rodenticide" } },
        { "label": "Antifreeze ingestion", "urgency": "RED", "when": { "substance": "antifreeze" } },
        { "label": "Grapes/raisins ingestion", "urgency": "RED", "when": { "substance": "grapes_raisins" } },
        { "label": "Lily ingestion (cat)", "urgency": "RED", "when": { "substance": "lily_cat" } },
        { "label": "NSAID / acetaminophen ingestion", "urgency": "RED", "when": { "substance": "nsaid_acetaminophen" } },
        { "label": "Pesticide / snail bait ingestion", "urgency": "RED", "when": { "substance": "snail_bait" } },
        { "label": "Battery ingestion", "urgency": "RED", "when": { "substance": "battery" } },
        { "label": "Chocolate ingestion", "urgency": "ORANGE", "when": { "substance": "chocolate" } },
        { "label": "Onion/garlic ingestion", "urgency": "ORANGE", "when": { "substance": "onion_garlic" } },
        { "label": "Human medication ingestion", "urgency": "ORANGE", "when": { "substance": "human_medication" } },
        { "label": "Marijuana/THC ingestion", "urgency": "ORANGE", "when": { "substance": "marijuana_thc" } },
        { "label": "Alcohol ingestion", "urgency": "ORANGE", "when": { "substance": "alcohol" } },
        { "label": "Caffeine ingestion", "urgency": "ORANGE", "when": { "substance": "caffeine" } },
        { "label": "Toxic plant ingestion", "urgency": "ORANGE", "when": { "substance": "toxic_plant" } },
        { "label": "Essential oil exposure", "urgency": "ORANGE", "when": { "substance": "essential_oil" } },
        { "label": "Household chemical ingestion", "urgency": "ORANGE", "when": { "substance": "household_chemical" } },
        { "label": "Unknown substance ingestion", "urgency": "ORANGE", "when": { "substance": "unknown" } }
      ]
    },

    {
      "id": "ENVIRONMENTAL",
      "label": "환경/사고성 응급",
      "origin": "extended",
      "goal": "열사병·저체온·익수·감전·기도이물(질식)·연기흡입 같은 환경·사고성 위급을 가른다.",
      "variables": {
        "heatstroke": { "concept": "더운 환경 후 헥헥+쓰러짐·축 늘어짐(열사병)", "values": ["no", "suspected"] },
        "hypothermia": { "concept": "추위 노출 후 몸이 차고 떨림·처짐(저체온)", "values": ["no", "suspected"] },
        "frostbite": { "concept": "귀끝·발끝·꼬리 동상(창백·검게 변함)", "values": ["no", "yes"] },
        "drowning": { "concept": "물에 빠짐(익수)", "values": ["no", "yes"] },
        "electric_burn": { "concept": "감전·전기화상", "values": ["no", "yes"] },
        "smoke_inhalation": { "concept": "화재·연기 흡입", "values": ["no", "yes"] },
        "choking": { "concept": "목에 걸려 숨 못 쉼·캑캑·청색증(기도이물)", "values": ["no", "yes"] },
        "insect_sting": { "concept": "벌·곤충 쏘임으로 붓고 가려움", "values": ["no", "yes"] }
      },
      "discriminators": [
        { "label": "Heatstroke", "urgency": "RED", "when": { "heatstroke": "suspected" } },
        { "label": "Drowning / near-drowning", "urgency": "RED", "when": { "drowning": "yes" } },
        { "label": "Choking / airway foreign body", "urgency": "RED", "when": { "choking": "yes" } },
        { "label": "Electric shock / burn", "urgency": "RED", "when": { "electric_burn": "yes" } },
        { "label": "Smoke inhalation", "urgency": "RED", "when": { "smoke_inhalation": "yes" } },
        { "label": "Hypothermia", "urgency": "ORANGE", "when": { "hypothermia": "suspected" } },
        { "label": "Frostbite", "urgency": "ORANGE", "when": { "frostbite": "yes" } },
        { "label": "Insect sting (localized)", "urgency": "YELLOW", "when": { "insect_sting": "yes" } }
      ]
    },

    {
      "id": "TRAUMA",
      "label": "외상/사고",
      "origin": "paper",
      "goal": "사고 종류와 상처 심각도를 파악한다. 교통사고·추락·동물 공격 직후엔 겉이 멀쩡해도 내부 손상 위험.",
      "variables": {
        "trauma_event": { "concept": "큰 사고(없음/교통사고·추락 등 고에너지/동물에 물림)", "values": ["none", "high_impact", "animal_attack"] },
